{{- /* Search index for log-it: every post, with its full text. */ -}}
{{- $root := site.GetPage "/log-it" -}}
{{- $out := slice -}}
{{- range $root.RegularPagesRecursive.ByDate -}}
  {{- $folder := "" -}}
  {{- with .Parent }}{{ if ne .RelPermalink $root.RelPermalink }}{{ $folder = .Title }}{{ end }}{{ end -}}
  {{- $out = $out | append (dict
      "title" .Title
      "url" .RelPermalink
      "date" (.Date.Format "2 Jan 2006")
      "folder" $folder
      "summary" (.Description | default "" | markdownify | plainify)
      "body" (partial "log-it/natbib.html" (dict "html" .Plain "page" . "plain" true) | replaceRE `\s+` " " | strings.TrimSpace)
  ) -}}
{{- end -}}
{{- $out | jsonify -}}
